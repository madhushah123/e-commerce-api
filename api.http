@baseUrl = http://localhost:3000

@userId = 64d8c2d1e0d9a4b5f1a2b3c4
@addressId = 64d8c2d1e0d9a4b5f1a2b3c5
@brandId = 64d8c2d1e0d9a4b5f1a2b3c6
@categoryId = 64d8c2d1e0d9a4b5f1a2b3c7
@productId = 64d8c2d1e0d9a4b5f1a2b3c8
@productImageId = 64d8c2d1e0d9a4b5f1a2b3d2
@productVariantId = 64d8c2d1e0d9a4b5f1a2b3d3
@cartId = 64d8c2d1e0d9a4b5f1a2b3c9
@cartItemId = 64d8c2d1e0d9a4b5f1a2b3d6
@couponId = 64d8c2d1e0d9a4b5f1a2b3ca
@orderId = 64d8c2d1e0d9a4b5f1a2b3cb
@orderItemId = 64d8c2d1e0d9a4b5f1a2b3d4
@orderCouponId = 64d8c2d1e0d9a4b5f1a2b3d5
@paymentId = 64d8c2d1e0d9a4b5f1a2b3cc
@reviewId = 64d8c2d1e0d9a4b5f1a2b3cd
@wishlistId = 64d8c2d1e0d9a4b5f1a2b3ce
@vendorId = 64d8c2d1e0d9a4b5f1a2b3cf
@notificationId = 64d8c2d1e0d9a4b5f1a2b3d0
@shipmentId = 64d8c2d1e0d9a4b5f1a2b3d1
@token = your_jwt_token_here

### --------------------------------------------------
### Auth
### --------------------------------------------------

### Register user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "user1@test.com",
  "password": "abcdefgh"
}

### Login user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user1@test.com",
  "password": "abcdefgh"
}

### --------------------------------------------------
### Users
### --------------------------------------------------

### Create user
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "abcdefgh"
}

### Get all users
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Get one user
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### Update user
PATCH {{baseUrl}}/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "John Updated",
  "email": "john.updated@example.com"
}

### Delete user
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{token}}

### --------------------------------------------------
### Addresses
### --------------------------------------------------

### Create address
POST {{baseUrl}}/addresses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "userId": "{{userId}}",
  "line1": "123 Main Street",
  "line2": "Apartment 4B",
  "city": "New York",
  "state": "NY",
  "country": "USA",
  "postalCode": "10001",
  "type": "home"
}

### Get all addresses
GET {{baseUrl}}/addresses
Authorization: Bearer {{token}}

### Get one address
GET {{baseUrl}}/addresses/{{addressId}}
Authorization: Bearer {{token}}

### Update address
PATCH {{baseUrl}}/addresses/{{addressId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "line1": "456 Updated Street",
  "city": "Brooklyn",
  "type": "work"
}

### Delete address
DELETE {{baseUrl}}/addresses/{{addressId}}
Authorization: Bearer {{token}}

### --------------------------------------------------
### Brands
### --------------------------------------------------

### Create brand
POST {{baseUrl}}/brands
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Nike",
  "description": "Sports and lifestyle products",
  "slug": "nike"
}

### Get all brands
GET {{baseUrl}}/brands
Authorization: Bearer {{token}}

### Get one brand
GET {{baseUrl}}/brands/{{brandId}}
Authorization: Bearer {{token}}

### Update brand
PATCH {{baseUrl}}/brands/{{brandId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Nike Updated",
  "description": "Updated sports brand description"
}

### Delete brand
DELETE {{baseUrl}}/brands/{{brandId}}
Authorization: Bearer {{token}}

### --------------------------------------------------
### Categories
### --------------------------------------------------

### Create category
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Electronics",
  "description": "Electronic gadgets and devices",
  "slug": "electronics"
}

### Get all categories
GET {{baseUrl}}/categories
Authorization: Bearer {{token}}

### Get one category
GET {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}

### Update category
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Electronics & Accessories",
  "description": "Updated category description"
}

### Delete category
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}

### --------------------------------------------------
### Products
### --------------------------------------------------

### Create product
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Wireless Headphones",
  "description": "Noise-cancelling over-ear headphones",
  "price": 249.99,
  "stock": 25,
  "categoryId": "{{categoryId}}",
  "brandId": "{{brandId}}",
  "isActive": true
}

### Get all products
GET {{baseUrl}}/products
Authorization: Bearer {{token}}

### Get one product
GET {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{token}}

### Update product
PATCH {{baseUrl}}/products/{{productId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "price": 229.99,
  "stock": 20,
  "description": "Updated product description"
}

### Delete product
DELETE {{baseUrl}}/products/{{productId}}
Authorization: Bearer {{token}}

### --------------------------------------------------
### Product Images
### --------------------------------------------------

### Create product image
POST {{baseUrl}}/product-images
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": "{{productId}}",
  "url": "https://example.com/images/product-main.jpg",
  "isPrimary": true
}

### Get all product images
GET {{baseUrl}}/product-images
Authorization: Bearer {{token}}

### Get one product image
GET {{baseUrl}}/product-images/{{productImageId}}
Authorization: Bearer {{token}}

### Update product image
PATCH {{baseUrl}}/product-images/{{productImageId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "url": "https://example.com/images/product-main-updated.jpg",
  "isPrimary": false
}

### Delete product image
DELETE {{baseUrl}}/product-images/{{productImageId}}
Authorization: Bearer {{token}}

